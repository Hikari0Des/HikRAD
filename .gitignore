# Secrets & local state — never commit
deploy/.env
*.env.local

# Runtime data (bind mounts from deploy/compose.yml)
deploy/data/
data/

# Go
backend/bin/
*.test
*.out
*.exe
coverage.*
# Toolchain tarballs downloaded for WSL2 dev (never commit)
go*.linux-amd64.tar.gz

# Node / frontend
node_modules/
frontend/*/dist/
frontend/*/.vite/
*.tsbuildinfo

# Editors & OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Backups & licenses (production artifacts live in /opt/hikrad, not the repo)
backups/
licenses/

# FreeRADIUS EAP PKI (FR-127): generated per-install by certs/bootstrap at
# install time, never checked in. Only the .cnf sources, Makefile,
# bootstrap script, README, and xpextensions are tracked — a local
# `./bootstrap` rehearsal inside deploy/freeradius/certs/ must never be
# re-committed by accident.
deploy/freeradius/certs/*.key
deploy/freeradius/certs/*.pem
deploy/freeradius/certs/*.der
deploy/freeradius/certs/*.crl
deploy/freeradius/certs/*.crt
deploy/freeradius/certs/*.csr
deploy/freeradius/certs/*.p12
deploy/freeradius/certs/dh
deploy/freeradius/certs/random
deploy/freeradius/certs/serial*
deploy/freeradius/certs/index.txt*
deploy/freeradius/certs/passwords.mk
deploy/freeradius/certs/[0-9][0-9].pem

# license-tool README's example commands write a real Ed25519 private key
# here (`go run . keygen -out vendor-key.b64`) — never commit it. The
# checked-in dev/pilot key is dev-vendor-key.b64 specifically, not this.
scripts/license-tool/vendor-key.b64

# Evidence pack: raw per-run JSON is regenerated by docs/evidence/generate.sh
# every run; only the rendered dated reports under docs/evidence/reports/ are
# committed (Phase 5, contract C6).
docs/evidence/raw/


# Claude Code agent worktrees (temporary full-repo copies — never commit)
.claude/worktrees/
