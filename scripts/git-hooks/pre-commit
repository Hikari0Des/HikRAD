#!/usr/bin/env bash
# pre-commit — FR-127 secret-scan hook. Not installed by default (git only
# runs hooks from .git/hooks/ unless core.hooksPath points elsewhere);
# opt in once per clone with:
#
#   git config core.hooksPath scripts/git-hooks
#
# Runs gitleaks against staged changes only (fast — seconds, not a full
# repo scan) so a secret never leaves the working tree in the first place.
# The same check also runs in CI (the secret-scan job, .gitleaks.toml) as
# the real gate — this hook is a courtesy that catches most leaks before a
# push, not the enforcement point itself.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed — skipping local secret scan (CI will still catch it)." >&2
  echo "  install: go install github.com/zricethezav/gitleaks/v8@latest" >&2
  exit 0
fi

if ! gitleaks protect --staged --config "$ROOT/.gitleaks.toml" --source "$ROOT"; then
  echo "" >&2
  echo "pre-commit: gitleaks found a likely secret in staged changes — commit refused." >&2
  echo "  If this is a real, verified false positive, add a specific allowlist entry" >&2
  echo "  to .gitleaks.toml (never a broad path/directory exclusion) and document why." >&2
  echo "  To bypass once with explicit justification: git commit --no-verify" >&2
  exit 1
fi
