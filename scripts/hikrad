#!/usr/bin/env bash
# hikrad — ops CLI wrapper (v4-2, FR-119: every `docker compose` call reworked
# onto systemctl/direct binary calls; adds `doctor` and `passwd` to match
# SAMM's maintenance CLI). Installed to /usr/local/bin by scripts/install.sh.

set -euo pipefail

# HIKRAD_ROOT_OVERRIDE: same sandboxed-prefix convention install.sh uses —
# never set in production, only by the scripts CI job / local rehearsal.
PREFIX="${HIKRAD_ROOT_OVERRIDE:-}"
ETC_DIR="$PREFIX/etc/hikrad"
ENV_FILE="$ETC_DIR/hikrad.env"
META_FILE="$ETC_DIR/install.meta"
VAR_DIR="$PREFIX/var/lib/hikrad"
BACKUP_DIR="$PREFIX/var/backups/hikrad"
BIN_DIR="$PREFIX/opt/hikrad/bin"
WWW_DIR="$PREFIX/opt/hikrad/www"
FR_DIR="$ETC_DIR/freeradius"
VERSION_FILE="$PREFIX/opt/hikrad/VERSION"
RELEASE_ROLLBACK_DIR="$PREFIX/opt/hikrad/release.rollback"
LIB_DIR="$PREFIX/opt/hikrad/lib"
LOCK_DIR="$VAR_DIR/data/updater"

# Dev fallback: running from a checkout with no real install yet (matches
# install.sh's own source-mode paths) — only ever used for things that don't
# need a live systemd/Postgres, e.g. this file being sourced by tests.
if [ ! -f "$META_FILE" ] && [ -z "$PREFIX" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    : "${SCRIPT_DIR:?}"
fi

log()  { printf '[hikrad] %s\n' "$*"; }
die()  { printf '[hikrad] ERROR: %s\n' "$*" >&2; exit 1; }

env_get() { # env_get KEY -> value from $ENV_FILE (last match wins)
    grep "^$1=" "$ENV_FILE" 2>/dev/null | tail -n1 | cut -d= -f2-
}

meta_get() { # meta_get KEY -> value from $META_FILE
    [ -f "$META_FILE" ] || return 0
    grep "^$1=" "$META_FILE" 2>/dev/null | tail -n1 | cut -d= -f2-
}

require_env() {
    [ -f "$ENV_FILE" ] || die "$ENV_FILE not found — is HikRAD installed? (sudo ./scripts/install.sh)"
}

require_tool() {
    command -v "$1" >/dev/null 2>&1 || die "$1 is required but not found on PATH"
}

pg_env() {
    PG_USER="$(env_get POSTGRES_USER)"; [ -n "$PG_USER" ] || PG_USER=hikrad
    PG_DB="$(env_get POSTGRES_DB)"; [ -n "$PG_DB" ] || PG_DB=hikrad
    PG_PASSWORD="$(env_get POSTGRES_PASSWORD)"
    PG_HOST="127.0.0.1"
}

# psql_app / pg_dump_app / pg_restore_app run as the `hikrad` application
# role over TCP (password auth) — the same role hikrad-api itself connects
# as. DDL that role isn't privileged for (DROP/CREATE DATABASE, during
# restore) goes through psql_admin instead (local peer auth as `postgres`,
# same as install.sh's own provisioning).
psql_app() { PGPASSWORD="$PG_PASSWORD" psql -h "$PG_HOST" -U "$PG_USER" -d "$PG_DB" -v ON_ERROR_STOP=1 "$@"; }
pg_dump_app() { PGPASSWORD="$PG_PASSWORD" pg_dump -h "$PG_HOST" -U "$PG_USER" -d "$PG_DB" "$@"; }
pg_restore_app() { PGPASSWORD="$PG_PASSWORD" pg_restore -h "$PG_HOST" -U "$PG_USER" -d "$PG_DB" "$@"; }
psql_admin() { sudo -u postgres psql -v ON_ERROR_STOP=1 "$@"; }

require_passphrase() {
    # An explicit HIKRAD_BACKUP_PASSPHRASE in the environment wins: restoring
    # onto a NEW server (disaster recovery) means decrypting with the OLD
    # server's passphrase, while this server's hikrad.env holds its own
    # freshly generated one — e.g. HIKRAD_BACKUP_PASSPHRASE='<old>' hikrad restore <archive>
    PASSPHRASE="${HIKRAD_BACKUP_PASSPHRASE:-$(env_get HIKRAD_BACKUP_PASSPHRASE)}"
    [ -n "$PASSPHRASE" ] || die "HIKRAD_BACKUP_PASSPHRASE not set in $ENV_FILE — cannot encrypt/decrypt backups (see docs/ops/backup-restore.md)."
}

backup_dir() { install -d -m 0750 "$BACKUP_DIR" >/dev/null 2>&1 || true; echo "$BACKUP_DIR"; }
data_dir()   { echo "$VAR_DIR"; }

# The six frozen unit names, filtered to the ones actually present on this
# install (hikrad-notification ships in v4-10; hikrad-updaterd is
# best-effort — see install.sh).
all_units() {
    local units="hikrad-api hikrad-acct hikrad-monitor hikrad-radius-worker"
    # enabled, not merely list-unit-files-visible: install.sh installs every
    # unit FILE unconditionally (so a later upgrade can enable one without
    # re-running the installer's own unit-copy step), but only enables
    # hikrad-updaterd/hikrad-notification when their binary actually exists
    # — checking enablement here, not file presence, is what keeps
    # `hikrad status`/`doctor`/restart-loops from reporting on a unit that
    # was never meant to run yet (hikrad-notification ships in v4-10).
    if systemctl is-enabled --quiet hikrad-updaterd.service 2>/dev/null; then
        units="$units hikrad-updaterd"
    fi
    if systemctl is-enabled --quiet hikrad-notification.service 2>/dev/null; then
        units="$units hikrad-notification"
    fi
    echo "$units"
}

wait_for_api_health() { # wait_for_api_health [timeout_seconds]
    local timeout="${1:-90}" waited=0 http_port
    http_port="$(meta_get HIKRAD_HTTP_PORT)"; [ -n "$http_port" ] || http_port=80
    while [ "$waited" -lt "$timeout" ]; do
        if curl -fsS -o /dev/null "http://127.0.0.1:8080/api/v1/system/version" 2>/dev/null; then
            return 0
        fi
        sleep 2
        waited=$((waited + 2))
    done
    return 1
}

max_available_schema_version() {
    local dir="$PREFIX/opt/hikrad/migrations"
    [ -d "$dir" ] || return 0
    # shellcheck disable=SC2012
    ls "$dir"/*.up.sql 2>/dev/null | sed -E 's#.*/([0-9]+)_.*#\1#' | sort -n | tail -1
}

record_backup_run() { # record_backup_run FILENAME SIZE_BYTES STATUS ERROR SCHEMA_VERSION TRIGGER
    local filename="$1" size="$2" status="$3" error="$4" schema="$5" trig="$6"
    local error_sql="NULL" schema_sql="NULL"
    if [ -n "$error" ]; then error_sql="'$(printf '%s' "$error" | sed "s/'/''/g")'"; fi
    if [ -n "$schema" ]; then schema_sql="$schema"; fi
    psql_app -q -c \
        "INSERT INTO backup_runs (filename, started_at, finished_at, size_bytes, schema_version, encrypted, status, error, trigger)
         VALUES ('$filename', now(), now(), $size, $schema_sql, true, '$status', $error_sql, '$trig');" \
        >/dev/null 2>&1 || log "WARNING: could not record backup_runs row (panel history will be incomplete; the archive itself is fine)"
}

apply_retention() {
    local dir="$1" retention
    retention="$(env_get HIKRAD_BACKUP_RETENTION)"
    [ -n "$retention" ] || retention=14
    # shellcheck disable=SC2012
    ls -1t "$dir"/hikrad-backup-*.tar.gz.gpg 2>/dev/null | tail -n "+$((retention + 1))" | while read -r old; do
        log "retention: removing $old"
        rm -f "$old"
    done
}

# --- backup (FR-51.1/51.2) ---------------------------------------------------
cmd_backup_now() {
    local trig="${1:-manual}"
    require_env
    require_tool gpg
    require_tool pg_dump
    require_passphrase
    pg_env
    local dir; dir="$(backup_dir)"

    local avail_kb
    avail_kb="$(df -Pk "$dir" 2>/dev/null | tail -1 | awk '{print $4}')"
    if [ -n "${avail_kb:-}" ] && [ "$avail_kb" -lt 524288 ]; then
        log "WARNING: less than 512MB free at $dir — a failing backup here alerts, it does not corrupt existing archives or rotation."
    fi

    local ts name work
    ts="$(date -u +%Y%m%dT%H%M%SZ)"
    name="hikrad-backup-$ts"
    work="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf '$work'" RETURN

    log "Dumping database ($PG_DB)…"
    if ! pg_dump_app -Fc > "$work/db.pgdump" 2>"$work/pg_dump.err"; then
        local err; err="$(tail -c 500 "$work/pg_dump.err" 2>/dev/null || echo "pg_dump failed")"
        record_backup_run "$name.tar.gz.gpg" 0 failed "$err" "" "$trig"
        die "backup failed: $err"
    fi

    cp "$ENV_FILE" "$work/hikrad.env"

    local schema_version
    schema_version="$(psql_app -tA -c "SELECT COALESCE((SELECT version FROM schema_migrations LIMIT 1), 0);" 2>/dev/null | tr -d '[:space:]')"
    [ -n "$schema_version" ] || schema_version=0
    echo "$schema_version" > "$work/schema_version"

    ( cd "$work" && tar -czf archive.tar.gz db.pgdump hikrad.env schema_version )

    local archive="$dir/$name.tar.gz.gpg"
    if ! gpg --batch --yes --passphrase "$PASSPHRASE" --pinentry-mode loopback \
            --symmetric --cipher-algo AES256 -o "$archive" "$work/archive.tar.gz" 2>"$work/gpg.err"; then
        record_backup_run "$name.tar.gz.gpg" 0 failed "$(tail -c 500 "$work/gpg.err")" "$schema_version" "$trig"
        die "backup encryption failed: $(tail -c 500 "$work/gpg.err")"
    fi

    local size
    size="$(stat -c%s "$archive" 2>/dev/null || stat -f%z "$archive" 2>/dev/null || echo 0)"
    record_backup_run "$(basename "$archive")" "$size" ok "" "$schema_version" "$trig"
    log "Backup written: $archive ($size bytes, schema v$schema_version)"

    apply_retention "$dir"
}

cmd_backup_list() {
    local dir; dir="$(backup_dir)"
    printf '%-34s %12s  %s\n' "FILE" "SIZE" "MODIFIED"
    # shellcheck disable=SC2012
    ls -1t "$dir"/hikrad-backup-*.tar.gz.gpg 2>/dev/null | while read -r f; do
        printf '%-34s %12s  %s\n' "$(basename "$f")" \
            "$(stat -c%s "$f" 2>/dev/null || stat -f%z "$f" 2>/dev/null)" \
            "$(date -u -r "$f" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
    done
}

# --- restore (FR-51.2/51.3) --------------------------------------------------
cmd_restore() {
    local input="${1:?usage: hikrad restore <archive>}"
    local archive="$input"
    [ -f "$archive" ] || archive="$(backup_dir)/$input"
    [ -f "$archive" ] || die "archive not found: $input"
    require_env
    require_tool gpg
    require_passphrase
    pg_env

    log "This STOPS the stack and REPLACES the database and hikrad.env with the archive's contents."
    if [ "${HIKRAD_RESTORE_YES:-0}" != "1" ]; then
        read -r -p "Type 'yes' to continue: " confirm
        [ "$confirm" = "yes" ] || die "restore cancelled"
    fi

    local work; work="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf '$work'" RETURN

    log "Decrypting archive…"
    gpg --batch --yes --passphrase "$PASSPHRASE" --pinentry-mode loopback \
        -o "$work/archive.tar.gz" -d "$archive" 2>"$work/gpg.err" \
        || die "decrypt failed (wrong passphrase or corrupt archive): $(tail -c 300 "$work/gpg.err")"
    tar -C "$work" -xzf "$work/archive.tar.gz"
    [ -f "$work/db.pgdump" ] || die "archive is missing db.pgdump — not a valid HikRAD backup"
    [ -f "$work/hikrad.env" ] || die "archive is missing hikrad.env — not a valid HikRAD backup"

    local archive_schema avail_schema
    archive_schema="$(cat "$work/schema_version" 2>/dev/null || echo 0)"
    avail_schema="$(max_available_schema_version)"
    if [ -n "$avail_schema" ] && [ "$archive_schema" -gt "$avail_schema" ]; then
        die "refusing to restore: archive schema v$archive_schema is newer than this install (max v$avail_schema) — run 'hikrad update' first, then retry."
    fi
    log "Archive schema v$archive_schema; this install supports up to v$avail_schema — forward migrations will run on next hikrad-api start."

    log "Stopping the stack…"
    for u in $(all_units); do systemctl stop "$u" 2>/dev/null || true; done

    # Restore into a SCRATCH database and swap it in only once pg_restore has
    # succeeded. The old flow dropped the live database first, so any failure
    # after that point (found live: timescaledb_pre_restore() refused to run
    # as the non-superuser app role) left the operator with an EMPTY database
    # and a restore that had destroyed the very data it was meant to recover.
    # The previous database is kept as ${PG_DB}_pre_restore until the next
    # restore, as a manual safety net.
    local staging="${PG_DB}_restore" previous="${PG_DB}_pre_restore"
    log "Restoring into a staging database ($staging) first — the current database is untouched until this succeeds…"
    psql_admin -c "DROP DATABASE IF EXISTS \"$staging\";"
    psql_admin -c "CREATE DATABASE \"$staging\" OWNER \"$PG_USER\";"
    # TimescaleDB hypertables need the extension created and the catalog put
    # into restore mode before pg_restore touches chunk tables, or COPY fails
    # with "could not find hypertable" — TimescaleDB's own documented
    # pg_dump/pg_restore procedure. Both calls ALTER DATABASE, which needs a
    # superuser, hence psql_admin (the app role gets "permission denied to set
    # parameter timescaledb.restoring").
    psql_admin -d "$staging" -c "CREATE EXTENSION IF NOT EXISTS timescaledb;"
    psql_admin -d "$staging" -c "SELECT timescaledb_pre_restore();"

    log "Restoring dump…"
    # As the postgres superuser, keeping the dump's owners and ACLs: the
    # timescaledb extension (and its _timescaledb_internal schema, where
    # every hypertable chunk and continuous-aggregate table lives) is owned
    # by postgres, so the app role got "permission denied for schema
    # _timescaledb_internal" on every chunk and the restore failed. Owners
    # are preserved (every app object stays owned by $PG_USER), so nothing
    # ends up postgres-owned and unreadable to hikrad-api.
    if ! sudo -u postgres pg_restore -d "$staging" < "$work/db.pgdump"; then
        psql_admin -c "DROP DATABASE IF EXISTS \"$staging\";" >/dev/null 2>&1 || true
        for u in $(all_units); do systemctl start "$u" 2>/dev/null || true; done
        die "pg_restore reported errors — the current database was NOT modified and the stack has been restarted on it (the archive itself is untouched)"
    fi
    psql_admin -d "$staging" -c "SELECT timescaledb_post_restore();"

    log "Swapping the restored database in (previous one kept as $previous)…"
    psql_admin -c "DROP DATABASE IF EXISTS \"$previous\";"
    psql_admin -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname IN ('$PG_DB', '$staging') AND pid <> pg_backend_pid();"
    psql_admin -c "ALTER DATABASE \"$PG_DB\" RENAME TO \"$previous\";" 2>/dev/null || true
    psql_admin -c "ALTER DATABASE \"$staging\" RENAME TO \"$PG_DB\";"

    cp "$ENV_FILE" "$ENV_FILE.pre-restore.bak"
    cp "$work/hikrad.env" "$ENV_FILE"
    log "hikrad.env restored (previous copy saved as $ENV_FILE.pre-restore.bak) — this is required: it carries the AES-GCM key that decrypts subscriber/NAS secrets."
    # The restored hikrad.env carries the SOURCE server's DB password. Restoring
    # onto a fresh server (the disaster-recovery case) left the local role on
    # its own install-time password, so hikrad-api could never connect. Re-key
    # the role to the password the services will now read.
    local restored_pw
    restored_pw="$(grep '^POSTGRES_PASSWORD=' "$ENV_FILE" | cut -d= -f2-)"
    if [ -n "$restored_pw" ]; then
        psql_admin -c "ALTER ROLE \"$PG_USER\" PASSWORD '$(printf '%s' "$restored_pw" | sed "s/'/''/g")';" >/dev/null             || log "WARNING: could not re-key role $PG_USER to the restored hikrad.env password — hikrad-api may fail to connect"
        PG_PASSWORD="$restored_pw"
    fi

    log "Starting the stack (hikrad-api applies forward migrations on boot)…"
    for u in $(all_units); do systemctl start "$u" 2>/dev/null || true; done
    if ! wait_for_api_health 120; then
        die "hikrad-api did not become healthy after restore — check: journalctl -u hikrad-api"
    fi

    local subs last_ledger last_acct
    subs="$(psql_app -tA -c "SELECT count(*) FROM subscribers;" 2>/dev/null | tr -d '[:space:]')"
    last_ledger="$(psql_app -tA -c "SELECT max(at) FROM ledger_transactions;" 2>/dev/null | tr -d '[:space:]')"
    last_acct="$(psql_app -tA -c "SELECT max(time) FROM usage_points;" 2>/dev/null | tr -d '[:space:]')"
    log "Restore complete. Verification summary:"
    log "  subscribers:            ${subs:-unknown}"
    log "  last ledger entry:      ${last_ledger:-none}"
    log "  last accounting record: ${last_acct:-none}"
    log "Confirm these match what you expect, then test a RADIUS auth (see docs/ops/pilot-checklist.md)."
}

# --- update (FR-51.4/51.5, retargeted onto systemd — FR-121) ----------------
# The daemon's own output-scanning (backend/cmd/hikrad-updaterd/run.go
# classifyStage/lockedLinePattern) matches EXACT substrings from this
# function's log lines — do not change the wording of the marked lines
# without updating run.go's patterns too (the phase brief's explicit
# "retarget, do not reimplement" instruction).
rollback_release() {
    [ -d "$RELEASE_ROLLBACK_DIR" ] || return 0
    log "Restoring the previous binaries/config from $RELEASE_ROLLBACK_DIR…"
    if [ -d "$RELEASE_ROLLBACK_DIR/bin" ]; then rm -rf "$BIN_DIR"; cp -a "$RELEASE_ROLLBACK_DIR/bin" "$BIN_DIR"; fi
    if [ -d "$RELEASE_ROLLBACK_DIR/www" ]; then rm -rf "$WWW_DIR"; cp -a "$RELEASE_ROLLBACK_DIR/www" "$WWW_DIR"; fi
    if [ -d "$RELEASE_ROLLBACK_DIR/freeradius" ]; then rm -rf "$FR_DIR"; cp -a "$RELEASE_ROLLBACK_DIR/freeradius" "$FR_DIR"; fi
}

cmd_update() {
    local bundle=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --bundle) bundle="${2:?--bundle requires a path}"; shift 2 ;;
            *) die "unknown update argument: $1 (usage: hikrad update [--bundle <tar>])" ;;
        esac
    done
    require_env

    # Shared lock (C3, unchanged from the pre-v4-2 daemon contract): held by
    # THIS process's own file descriptor for its own lifetime, not by
    # hikrad-updaterd — this is what makes "only one update at a time"
    # survive the daemon dying mid-update (FR-86.5/gate item 11). The exact
    # wording of the die message below is matched by backend/cmd/
    # hikrad-updaterd/run.go's lockedLinePattern — do not change it.
    install -d -m 0750 "$LOCK_DIR"
    exec 9>"$LOCK_DIR/update.lock"
    flock -n 9 || die "update already in progress (locked) — another update is already running"

    log "Pre-update backup…"
    cmd_backup_now pre_update

    # Which install.sh applies the update. It used to be looked up next to
    # this CLI (/usr/local/bin) or at the Docker-era /opt/hikrad/release path
    # — neither exists on a native install, so every `hikrad update` (and the
    # panel's update button, which drives it) failed and rolled back.
    #   bundle: the NEW release's own installer, but only after the bundle
    #           verifies against the INSTALLED (trusted) verifier.
    #   source: the checkout install.sh recorded (operator git-pulls first).
    local install_sh="" work=""
    local install_status=0
    if [ -n "$bundle" ]; then
        [ -f "$bundle" ] || die "--bundle file not found: $bundle"
        # This line's wording is what run.go's classifyStage keys off, see
        # that file's own comment.
        log "Verifying release bundle $bundle before using anything from it…"
        work="$(mktemp -d)"
        # shellcheck disable=SC2064
        trap "rm -rf '$work'" RETURN
        tar -xf "$bundle" -C "$work" || die "could not extract $bundle — nothing was changed"
        local verifier="$LIB_DIR/verify-bundle.sh"
        if [ ! -f "$verifier" ]; then
            # Installs from before the trusted copy existed: fall back to the
            # recorded source checkout's verifier, never the bundle's own.
            local src; src="$(meta_get HIKRAD_SOURCE_DIR)"
            [ -n "$src" ] && [ -f "$src/scripts/verify-bundle.sh" ] && verifier="$src/scripts/verify-bundle.sh"
        fi
        [ -f "$verifier" ] || die "no trusted verify-bundle.sh at $LIB_DIR — re-run install.sh from your current release first, then retry."
        bash "$verifier" "$work" || die "bundle verification failed — refusing to update from $bundle (nothing was changed)"
        install_sh="$work/scripts/install.sh"
    else
        local src; src="$(meta_get HIKRAD_SOURCE_DIR)"
        if [ -z "$src" ] || [ ! -f "$src/scripts/install.sh" ]; then
            die "no --bundle given and no source checkout recorded in $META_FILE — use: hikrad update --bundle hikrad-vX.Y.Z.tar"
        fi
        install_sh="$src/scripts/install.sh"
    fi

    log "Applying update (hikrad-api runs forward-only migrations on boot)…"
    if [ -n "$bundle" ]; then
        bash "$install_sh" --bundle "$bundle" || install_status=$?
    else
        bash "$install_sh" || install_status=$?
    fi

    if [ "$install_status" -ne 0 ]; then
        log "install.sh failed — rolling back to the previous release."
        rollback_release
        for u in $(all_units); do systemctl restart "$u" 2>/dev/null || true; done
        die "update failed to apply; rolled back to the previous release. The pre-update backup above is available if data needs restoring too."
    fi

    if ! wait_for_api_health 120; then
        log "hikrad-api did not become healthy after update — rolling back to the previous release."
        rollback_release
        for u in $(all_units); do systemctl restart "$u" 2>/dev/null || true; done
        die "update rolled back to the previous version. If a migration partially applied, run: hikrad restore <the pre-update backup listed above>"
    fi

    log "Update complete and healthy."
}

# --- doctor (v4-2, FR-119: SAMM-parity health check) -------------------------
cmd_doctor() {
    require_env
    local issues=0
    log "hikrad doctor — checking every unit, dependency, and config file…"

    for u in $(all_units) nginx postgresql redis-server; do
        if systemctl is-active --quiet "$u" 2>/dev/null; then
            printf '  [OK]   %s is active\n' "$u"
        else
            printf '  [FAIL] %s is NOT active (systemctl status %s)\n' "$u" "$u"
            issues=$((issues + 1))
        fi
    done

    pg_env
    if psql_app -c 'SELECT 1' >/dev/null 2>&1; then
        printf '  [OK]   PostgreSQL reachable as %s/%s\n' "$PG_USER" "$PG_DB"
    else
        printf '  [FAIL] cannot connect to PostgreSQL as %s/%s\n' "$PG_USER" "$PG_DB"
        issues=$((issues + 1))
    fi

    if [ -d "$FR_DIR" ] && command -v freeradius >/dev/null 2>&1; then
        if freeradius -CX -d "$FR_DIR" >/tmp/hikrad-doctor-fr.log 2>&1; then
            printf '  [OK]   FreeRADIUS config validates (freeradius -CX)\n'
        else
            printf '  [FAIL] FreeRADIUS config invalid — see /tmp/hikrad-doctor-fr.log\n'
            issues=$((issues + 1))
        fi
    fi

    if command -v nginx >/dev/null 2>&1; then
        if nginx -t >/tmp/hikrad-doctor-nginx.log 2>&1; then
            printf '  [OK]   nginx config validates (nginx -t)\n'
        else
            printf '  [FAIL] nginx config invalid — see /tmp/hikrad-doctor-nginx.log\n'
            issues=$((issues + 1))
        fi
    fi

    if curl -fsS -o /dev/null "http://127.0.0.1:8080/api/v1/system/version" 2>/dev/null; then
        printf '  [OK]   hikrad-api answers /api/v1/system/version\n'
    else
        printf '  [FAIL] hikrad-api not answering on 127.0.0.1:8080\n'
        issues=$((issues + 1))
    fi

    local avail_kb
    avail_kb="$(df -Pk "$(data_dir)" 2>/dev/null | tail -1 | awk '{print $4}')"
    if [ -n "${avail_kb:-}" ] && [ "$avail_kb" -lt 1048576 ]; then
        printf '  [WARN] less than 1GB free at %s\n' "$(data_dir)"
    fi

    if [ "$issues" -eq 0 ]; then
        log "doctor: all checks passed."
    else
        die "doctor: $issues check(s) failed — see above."
    fi
}

# --- passwd (v4-2, FR-119: SAMM-parity admin password reset) ----------------
cmd_passwd() {
    local username="${1:?usage: hikrad passwd <username>}"
    require_env
    [ -x "$BIN_DIR/hikrad-api" ] || die "hikrad-api binary not found at $BIN_DIR/hikrad-api"
    # shellcheck disable=SC1090
    set -a; . "$ENV_FILE"; set +a
    "$BIN_DIR/hikrad-api" reset-manager-password "$username"
}

# --- tunnel (FR-57, native replacement for the compose `tunnel` profile) ----
cmd_tunnel() {
    require_env
    local token_file="$ETC_DIR/cloudflared-token"
    case "${1:-}" in
        enable)
            [ -x "$BIN_DIR/hikrad-api" ] || die "hikrad-api binary not found"
            # shellcheck disable=SC1090
            set -a; . "$ENV_FILE"; set +a
            if ! "$BIN_DIR/hikrad-api" print-tunnel-token > "$token_file" 2>/tmp/hikrad-tunnel.err; then
                die "no remote_access.token configured — set it in Settings > Remote Access first: $(cat /tmp/hikrad-tunnel.err 2>/dev/null)"
            fi
            chmod 0600 "$token_file"
            [ -s "$token_file" ] || die "remote_access.token is empty — set it in Settings > Remote Access first"
            systemctl enable --now hikrad-tunnel
            log "hikrad-tunnel started."
            ;;
        disable)
            systemctl disable --now hikrad-tunnel 2>/dev/null || true
            log "hikrad-tunnel stopped. No other service was touched (NFR-7)."
            ;;
        *) die "usage: hikrad tunnel enable|disable" ;;
    esac
}

# --- uninstall (item 12) -----------------------------------------------------
cmd_uninstall() {
    local yes=0 purge=0 keep_data=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --yes) yes=1; shift ;;
            --purge) purge=1; shift ;;
            --keep-data) keep_data=1; shift ;;
            *) die "unknown uninstall argument: $1 (usage: hikrad uninstall [--yes] [--keep-data] [--purge])" ;;
        esac
    done
    if [ "$purge" = 1 ] && [ "$keep_data" = 1 ]; then die "--purge and --keep-data contradict each other"; fi

    if [ "$yes" != 1 ]; then
        [ -t 0 ] || die "refusing to uninstall non-interactively without --yes"
        cat <<EOF
This will REMOVE the HikRAD installation:
  - stop and disable every hikrad-* systemd unit and delete their unit files
  - remove the nightly backup timer and /usr/local/bin/hikrad
  - remove the nginx site (other sites on this host are untouched)
$( [ "$keep_data" = 1 ] \
    && echo "  - data directory ($VAR_DIR) is KEPT (--keep-data)" \
    || echo "  - DELETE the data directory (database, sessions, usage history)" )
$( [ "$purge" = 1 ] \
    && echo "  - DELETE backups AND the PostgreSQL database itself (--purge): after this NOTHING is recoverable" \
    || echo "  - backups under $(backup_dir) are kept; the PostgreSQL database is left as-is" )

Type exactly 'uninstall hikrad' to continue:
EOF
        local answer
        read -r answer
        [ "$answer" = "uninstall hikrad" ] || { log "Aborted. Nothing changed."; exit 0; }
    fi

    if [ "$keep_data" != 1 ] && [ "$purge" != 1 ]; then
        log "Taking a final backup before removal (kept in $(backup_dir))…"
        cmd_backup_now pre_uninstall || log "WARNING: final backup failed — continuing (data dir is about to be removed!)"
    fi

    # Capture the DB identity BEFORE hikrad.env is deleted below (--purge
    # only) — otherwise a subsequent fresh install generates a brand-new
    # random POSTGRES_PASSWORD, install.sh's "never touch an existing
    # role's password" idempotency guarantee (correct on its own) leaves
    # the OLD password on the surviving PostgreSQL role, and the two can
    # never agree again — found live: exactly this sequence, on a real
    # uninstall --purge followed by a real fresh install.
    if [ "$purge" = 1 ] && [ -f "$ENV_FILE" ]; then
        pg_env
        PURGE_PG_USER="$PG_USER"
        PURGE_PG_DB="$PG_DB"
    fi

    log "Stopping and disabling every HikRAD unit…"
    for u in $(all_units) hikrad-tunnel hikrad-backup.timer; do
        systemctl disable --now "$u" 2>/dev/null || true
        rm -f "/etc/systemd/system/$u"* 2>/dev/null || true
    done
    systemctl daemon-reload 2>/dev/null || true

    rm -f "$PREFIX/etc/nginx/sites-enabled/hikrad.conf" "$PREFIX/etc/nginx/sites-available/hikrad.conf"
    systemctl reload nginx 2>/dev/null || true

    if [ "$keep_data" != 1 ]; then
        if [ -d "$VAR_DIR" ]; then log "Deleting data directory $VAR_DIR…"; rm -rf "$VAR_DIR"; fi
    else
        log "Keeping data directory $VAR_DIR (--keep-data)."
    fi

    if [ "$purge" = 1 ]; then
        if [ -n "${PURGE_PG_USER:-}" ]; then
            log "Dropping PostgreSQL database '$PURGE_PG_DB' and role '$PURGE_PG_USER'…"
            psql_admin -c "DROP DATABASE IF EXISTS \"$PURGE_PG_DB\";" 2>/dev/null \
                || log "WARNING: could not drop database $PURGE_PG_DB — drop it manually: sudo -u postgres dropdb $PURGE_PG_DB"
            psql_admin -c "DROP ROLE IF EXISTS \"$PURGE_PG_USER\";" 2>/dev/null \
                || log "WARNING: could not drop role $PURGE_PG_USER — drop it manually: sudo -u postgres dropuser $PURGE_PG_USER"
        fi
        log "Purging backups and config…"
        rm -rf "$BACKUP_DIR" "$ETC_DIR" "$PREFIX/opt/hikrad"
    else
        log "Kept: $(backup_dir) and $ENV_FILE (needed to decrypt the backups)."
        rm -rf "$PREFIX/opt/hikrad"
        find "$ETC_DIR" -mindepth 1 -maxdepth 1 ! -name hikrad.env ! -name install.meta -exec rm -rf {} + 2>/dev/null || true
    fi

    rm -f "$PREFIX/usr/local/bin/hikrad" 2>/dev/null \
        || log "NOTE: could not remove $PREFIX/usr/local/bin/hikrad (not root?) — remove it manually."

    log "HikRAD is uninstalled. PostgreSQL, Redis, nginx, and FreeRADIUS packages were NOT removed (they may serve other workloads)."
}

# --- factory-reset (owner request 2026-07-17) --------------------------------
cmd_factory_reset() {
    local yes=0 no_backup=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --yes) yes=1; shift ;;
            --no-backup) no_backup=1; shift ;;
            *) die "unknown factory-reset argument: $1 (usage: hikrad factory-reset [--yes] [--no-backup])" ;;
        esac
    done
    require_env
    pg_env

    if [ "$yes" != 1 ]; then
        [ -t 0 ] || die "refusing to factory-reset non-interactively without --yes"
        cat <<EOF
This will ERASE ALL DATA in the '$PG_DB' database and start HikRAD fresh:
  - every subscriber, profile, NAS, session, ledger entry, report and manager
  - the installed license (the first-run wizard will ask for it again)
$( [ "$no_backup" = 1 ] \
    && echo "  - NO safety backup will be taken (--no-backup)" \
    || echo "  - a final backup is taken first and kept in $(backup_dir)" )
The installation itself (binaries, hikrad.env, backups, hikrad CLI) is kept.

Type exactly 'factory reset' to continue:
EOF
        local answer
        read -r answer
        [ "$answer" = "factory reset" ] || { log "Aborted. Nothing changed."; exit 0; }
    fi

    if [ "$no_backup" != 1 ]; then
        log "Taking a safety backup before the wipe (kept in $(backup_dir))…"
        cmd_backup_now pre_factory_reset \
            || die "the safety backup failed — fix that first, or pass --no-backup to explicitly skip it"
    fi

    log "Stopping the stack…"
    for u in $(all_units); do systemctl stop "$u" 2>/dev/null || true; done

    log "Dropping and recreating $PG_DB…"
    psql_admin -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$PG_DB' AND pid <> pg_backend_pid();"
    psql_admin -c "DROP DATABASE IF EXISTS \"$PG_DB\";"
    psql_admin -c "CREATE DATABASE \"$PG_DB\" OWNER \"$PG_USER\";"
    psql_admin -d "$PG_DB" -c "CREATE EXTENSION IF NOT EXISTS timescaledb;"

    # Wipe the runtime data dir but recreate the bind-mount-era ownerships
    # exactly as install.sh prepares them (anti-pattern A11 — the fix must
    # cover factory-reset too, not just install/upgrade).
    log "Wiping $VAR_DIR…"
    rm -rf "$VAR_DIR"/{branding,acct-spill,radius-control,incoming,data} 2>/dev/null || true
    install -d -m 0750 -o hikrad-api -g hikrad-api "$VAR_DIR/branding"
    install -d -m 0750 -o hikrad-acct -g hikrad-acct "$VAR_DIR/acct-spill"
    install -d -m 0777 "$VAR_DIR/radius-control"
    install -d -m 0750 "$VAR_DIR/incoming" "$VAR_DIR/data/updater"

    # The generated FreeRADIUS client list reflects the (now wiped) NAS table.
    if [ -f "$FR_DIR/clients-generated.conf" ]; then
        : > "$FR_DIR/clients-generated.conf"
        chown hikrad-api:hikrad-api "$FR_DIR/clients-generated.conf" 2>/dev/null || true
    fi

    log "Starting the stack (fresh database; migrations run on hikrad-api boot)…"
    for u in $(all_units); do systemctl start "$u" 2>/dev/null || true; done
    if ! wait_for_api_health 180; then
        die "hikrad-api did not become healthy after the reset — check: journalctl -u hikrad-api"
    fi

    log "Factory reset complete. Open the panel to run the first-run wizard."
}

# --- migrate-to-native (FR-118 §3.5): existing Compose install -> native ----
cmd_migrate_to_native() {
    local script_dir; script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    bash "$script_dir/migrate-to-native.sh" "$@"
}

usage() {
    cat <<'EOF'
Usage: hikrad <command>

  status              show every unit's systemctl status
  logs [svc]          follow journald logs (all hikrad-* units, or one:
                      api|acct|monitor|radius|updater|notification)
  doctor              run every health check SAMM's maintenance CLI has
                      (units active, Postgres reachable, FreeRADIUS/nginx
                      config valid, hikrad-api answering)
  passwd <username>   reset a manager's password directly in the database
                      (recovery path when locked out of the panel)

  backup now          take a passphrase-encrypted backup immediately
  backup list         list available backups
  restore <archive>   stop, restore, migrate, verify (FR-51.2/51.3)
  update [--bundle F] pre-backup, stage the new release, migrate, rollback
                      on failure (FR-51.4/51.5, FR-121)

  tunnel enable|disable   start/stop the optional Cloudflare tunnel (FR-57)

  migrate-to-native [--yes]
              one-way migration for an existing Docker Compose install:
              stops the old stack, dumps its data, runs this native
              installer, restores, verifies — see docs/ops/update.md

  factory-reset [--yes] [--no-backup]
              ERASE all data (subscribers, ledger, license, managers) and
              boot a fresh, empty system — the install itself is kept.
              Takes a safety backup first unless --no-backup.

  uninstall [--yes] [--keep-data] [--purge]
              remove HikRAD completely: units, nginx site, CLI. Takes a
              final backup and keeps backups + hikrad.env unless --purge.
EOF
}

svc_short_to_unit() {
    case "$1" in
        api) echo hikrad-api ;;
        acct) echo hikrad-acct ;;
        monitor) echo hikrad-monitor ;;
        radius) echo hikrad-radius-worker ;;
        updater) echo hikrad-updaterd ;;
        notification) echo hikrad-notification ;;
        *) echo "$1" ;;
    esac
}

case "${1:-}" in
    status)
        for u in $(all_units) nginx postgresql redis-server; do
            printf '%-24s ' "$u"
            systemctl is-active "$u" 2>/dev/null || echo "unknown"
        done
        ;;
    logs)
        shift
        if [ $# -eq 0 ]; then
            args=()
            for u in $(all_units); do args+=(-u "$u"); done
            journalctl "${args[@]}" -f --no-pager
        else
            journalctl -u "$(svc_short_to_unit "$1")" -f --no-pager
        fi
        ;;
    doctor) cmd_doctor ;;
    passwd) shift; cmd_passwd "${1:-}" ;;
    backup)
        case "${2:-}" in
            now) cmd_backup_now manual ;;
            list|"") cmd_backup_list ;;
            *) die "usage: hikrad backup now|list" ;;
        esac
        ;;
    restore)  shift; cmd_restore "${1:-}" ;;
    update)   shift; cmd_update "$@" ;;
    tunnel)   shift; cmd_tunnel "${1:-}" ;;
    migrate-to-native) shift; cmd_migrate_to_native "$@" ;;
    factory-reset) shift; cmd_factory_reset "$@" ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    -h|--help|help|"") usage ;;
    *)
        echo "hikrad: unknown command '$1'" >&2
        usage >&2
        exit 1
        ;;
esac
