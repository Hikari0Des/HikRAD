# HikRAD lossless accounting ingest (v4-2, FR-118). Acks 204 only after a
# durable enqueue — see internal/accounting's own docs for the pipeline.
[Unit]
Description=HikRAD accounting ingest
Documentation=https://github.com/Hikari0Des/HikRAD
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=hikrad-acct
Group=hikrad-acct
EnvironmentFile=/etc/hikrad/hikrad.env
Environment=HIKRAD_ACCT_SPILL_DIR=/var/lib/hikrad/acct-spill
ExecStart=/opt/hikrad/bin/hikrad-acct
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/hikrad/acct-spill

[Install]
WantedBy=multi-user.target
