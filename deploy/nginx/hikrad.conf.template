# HikRAD nginx site (v4-2, FR-118, Decision 59 — replaces Caddy).
#
# Installed by scripts/install.sh as /etc/nginx/sites-available/hikrad.conf
# (symlinked into sites-enabled/) — a SEPARATE site file, additive to
# whatever else nginx already serves on this host (gate item 4): install.sh
# never edits nginx.conf, never touches another site's server block, and
# never removes the distro default site (it may still be enabled; this site
# simply also listens).
#
# @@HTTP_PORT@@ / @@HTTPS_PORT@@ are substituted by install.sh at install
# time (default 80/443, prompted-and-remembered on a port clash — gate item
# 5) — this is the ONLY templating install.sh does to this file; everything
# else ships byte-identical from the repo/bundle.
#
#   /            -> admin panel static build   (/opt/hikrad/www/panel)
#   /portal      -> subscriber portal build     (/opt/hikrad/www/portal)
#   /api/*       -> hikrad-api:8080              (REST API, /api/v1/...)
#
# Only /api/* is proxied. The FreeRADIUS policy/dynamic-client endpoints
# (POST /internal/radius/*) are served on the same backend port but are
# deliberately NOT reachable through this site (same C4 contract as before).

server {
	listen @@HTTP_PORT@@ default_server;
	listen [::]:@@HTTP_PORT@@ default_server;
	server_name _;
	return 301 https://$host:@@HTTPS_PORT@@$request_uri;
}

server {
	listen @@HTTPS_PORT@@ ssl default_server;
	listen [::]:@@HTTPS_PORT@@ ssl default_server;
	server_name _;
	http2 on;

	# Offline-first default (NFR-7, FR-49.5): a self-signed certificate
	# covering this server's own detected IP address(es), generated by
	# install.sh into /etc/hikrad/tls/{cert,key}.pem (regenerate by deleting
	# that directory and re-running install.sh, or switch to a real
	# certificate with `install.sh --domain ...`, which runs certbot's
	# nginx plugin and it rewrites the ssl_certificate lines below itself).
	ssl_certificate     /etc/hikrad/tls/cert.pem;
	ssl_certificate_key /etc/hikrad/tls/key.pem;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_prefer_server_ciphers off;

	# ASVS V9.1/V14 baseline hardening (unchanged from the Caddy default).
	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header Referrer-Policy "same-origin" always;

	gzip on;
	gzip_types text/css application/javascript application/json image/svg+xml;

	location /api/ {
		proxy_pass http://127.0.0.1:8080;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}

	location = /portal {
		return 301 /portal/;
	}

	# Portal SPA at /portal/, stripped so it's built and served from its own
	# root (matches the Vite base config, same contract the old Caddyfile
	# used with handle_path).
	location /portal/ {
		alias /opt/hikrad/www/portal/;
		try_files $uri $uri/ /portal/index.html;
	}

	# Everything else: admin panel SPA.
	location / {
		root /opt/hikrad/www/panel;
		try_files $uri $uri/ /index.html;
	}
}
