# HikRAD environment — v4-2 native install (FR-118). This is what
# scripts/install.sh writes to /etc/hikrad/hikrad.env in production, and
# what scripts/gen-env.sh writes to deploy/hikrad.env for local dev.
#
# Do NOT fill this in by hand: run  scripts/gen-env.sh deploy/hikrad.env  to
# generate real secrets. This file documents the shape and safe defaults
# only. The generated hikrad.env is gitignored and must never be committed.

POSTGRES_USER=hikrad
POSTGRES_PASSWORD=CHANGE_ME_generated_by_gen-env
POSTGRES_DB=hikrad

# --- Frozen app env names — every hikrad-* systemd unit's EnvironmentFile
# reads these. Native install: everything runs on this same host, so URLs
# below are localhost, never a Compose service name.
HIKRAD_DB_URL=postgres://hikrad:CHANGE_ME_generated_by_gen-env@127.0.0.1:5432/hikrad?sslmode=disable
HIKRAD_REDIS_URL=redis://127.0.0.1:6379/0
# 32 bytes, base64 — AES-256-GCM key for reversible subscriber RADIUS
# passwords (NFR-4.2). Losing this key makes CHAP auth impossible: back it up.
HIKRAD_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_-base64_32
# HMAC secret for panel/portal access + refresh tokens.
HIKRAD_JWT_SECRET=CHANGE_ME_generated_by_gen-env
# Shared secret authenticating hikrad-api's calls to hikrad-updaterd over
# their unix socket (FR-86.2, retargeted onto systemd in v4-2/FR-121).
HIKRAD_UPDATER_TOKEN=CHANGE_ME_generated_by_gen-env
# dev enables the Phase-1 auth stub (admin/admin) and seed data paths (C7).
# Production installs must use prod.
HIKRAD_ENV=dev

# --- Backup (FR-51) ---
HIKRAD_BACKUP_PASSPHRASE=CHANGE_ME_generated_by_gen-env
HIKRAD_BACKUP_RETENTION=14
