# HikRAD Notification Center worker — unit name reserved by the v4-2 native
# install contract (docs/v4/phases/phase-v4-2-native-install/00-phase.md §4)
# so the panel's future health page and hikrad-updaterd can address it by a
# stable name from day one. The binary itself ships in v4-10 (Notification
# Center / FR-160-165) — until then install.sh installs this unit file but
# does NOT enable or start it (no /opt/hikrad/bin/hikrad-notification to
# run yet); re-running the installer after v4-10 picks it up with no other
# change, the same best-effort "install if present" posture install.sh
# already uses for hikrad-updaterd.
[Unit]
Description=HikRAD notification center worker
Documentation=https://github.com/Hikari0Des/HikRAD
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=hikrad-notification
Group=hikrad-notification
EnvironmentFile=/etc/hikrad/hikrad.env
ExecStart=/opt/hikrad/bin/hikrad-notification
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
