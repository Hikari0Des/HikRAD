# HikRAD-owned FreeRADIUS instance (v4-2, FR-118). Runs the SAME freeradius
# binary the distro package installs, but pointed at HikRAD's own raddb tree
# (/etc/hikrad/freeradius) and under this HikRAD-owned unit name instead of
# the distro's own "freeradius.service" — install.sh disables/masks that one
# so the two never fight over UDP 1812/1813/3799 or read the wrong config.
#
# No User=/Group= here: like the distro's own unit, radiusd starts as root
# (needed to read TLS private keys and, on some installs, bind low ports),
# reads /etc/hikrad/freeradius/radiusd.conf's `user =`/`group =` directives
# (set to hikrad-radius:hikrad-radius by install.sh), and drops privileges
# itself before processing any packet — do not fight this with systemd
# User=, it would remove radiusd's own ability to setuid down safely.
[Unit]
Description=HikRAD RADIUS worker (FreeRADIUS, HikRAD-owned instance)
Documentation=https://github.com/Hikari0Des/HikRAD
After=network-online.target hikrad-api.service
Wants=network-online.target
# Not Requires=hikrad-api: FreeRADIUS should still come up (and queue
# retransmits) even if hikrad-api is mid-restart — NFR-1 resilience, matches
# the existing authorize.pl/accounting.pl fail-closed-per-packet posture
# rather than a hard service dependency.

[Service]
Type=simple
# Deliberately NO Environment=HIKRAD_AUTHORIZE_URL/etc. here — found live
# (the real root cause behind the packet-harness gate hanging ~10s per
# request then failing closed): rlm_exec's input_pairs mode builds a FRESH
# environment for each exec'd script containing only the mapped request
# attributes; it does NOT inherit this unit's own Environment= lines at
# all, so setting them here is silent, expensive-looking dead
# configuration. scripts/authorize.pl, accounting.pl, and dynamic-client.pl
# instead default to native loopback (127.0.0.1) directly in the script
# itself — that default, not anything set here, is what actually applies.
# -l stdout: send radiusd's log to journald (CLAUDE.md: "logs via journald",
# no log files) instead of the default /var/log/freeradius/radius.log.
ExecStartPre=/usr/sbin/freeradius -CX -d /etc/hikrad/freeradius
ExecStart=/usr/sbin/freeradius -f -l stdout -d /etc/hikrad/freeradius
Restart=on-failure
RestartSec=2
TimeoutStartSec=60

NoNewPrivileges=yes
ReadWritePaths=/var/lib/hikrad/radius-control

[Install]
WantedBy=multi-user.target
