# HikRAD REST API + FreeRADIUS policy endpoint (v4-2, FR-118/121).
# Installed verbatim to /etc/systemd/system/ by scripts/install.sh — paths
# below are the frozen contract (docs/v4/phases/phase-v4-2-native-install/
# 00-phase.md §4): binaries /opt/hikrad/bin, config /etc/hikrad, data
# /var/lib/hikrad, backups /var/backups/hikrad.
[Unit]
Description=HikRAD API (panel/portal REST + FreeRADIUS policy endpoint)
Documentation=https://github.com/Hikari0Des/HikRAD
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=hikrad-api
Group=hikrad-api
EnvironmentFile=/etc/hikrad/hikrad.env
Environment=HIKRAD_MIGRATIONS_DIR=/opt/hikrad/migrations
Environment=HIKRAD_RADIUS_CLIENTS_PATH=/etc/hikrad/freeradius/clients-generated.conf
Environment=HIKRAD_RADIUS_CONTROL_SOCKET=/var/lib/hikrad/radius-control/freeradius.sock
Environment=HIKRAD_UPDATER_SOCKET=/run/hikrad/updater.sock
Environment=HIKRAD_BRANDING_DIR=/var/lib/hikrad/branding
ExecStart=/opt/hikrad/bin/hikrad-api
Restart=on-failure
RestartSec=2
TimeoutStartSec=180

# Hardening (FR-118 §3.1 step 7: "dedicated non-root user, ProtectSystem,
# PrivateTmp, Restart="). ReadWritePaths is the one deliberate opening in
# ProtectSystem=strict — everything else on disk is read-only to this unit.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# RuntimeDirectory=hikrad, not just a ReadWritePaths entry: /run/hikrad
# must actually EXIST before this unit's mount namespace is set up, or
# systemd fails the whole start with "226/NAMESPACE" (found live — this
# unit starting before/without hikrad-updaterd.service, the only other
# thing that happened to create the directory via its own
# RuntimeDirectory=, raced exactly this). Declaring it here too makes
# systemd create (and ref-count — safe whichever of the two units starts
# or stops first) it regardless of updater state.
RuntimeDirectory=hikrad
RuntimeDirectoryMode=0755
ReadWritePaths=/var/lib/hikrad/branding /var/lib/hikrad/radius-control /run/hikrad /etc/hikrad/freeradius/clients-generated.conf

[Install]
WantedBy=multi-user.target
