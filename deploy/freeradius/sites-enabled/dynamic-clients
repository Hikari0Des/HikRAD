# -*- text -*-
# HikRAD dynamic-clients virtual server (v4-2, FR-118, gate item 9).
#
# Triggered by clients.conf's `hikrad_dynamic` range the first time a packet
# arrives from a source IP FreeRADIUS has no client for. hikrad_dynamic_client
# (mods-available/hikrad_dynamic_client -> scripts/dynamic-client.pl) looks the
# source IP up against HikRAD's `nas` table (via hikrad-api, decrypting the
# stored secret only in that process, same as the main authorize path); on a
# hit it fills in the control:FreeRADIUS-Client-* attributes FreeRADIUS's own
# built-in `dynamic_clients` policy (mods-available/dynamic_clients) reads to
# create and cache an in-memory client — no reload, no restart. On a miss (or
# any backend error) the script exits non-zero, `ok` is false, and the
# unrecognized packet is rejected exactly as an unknown client always was.
#
# See deploy/freeradius/README.md for the full request flow and why this uses
# an `exec` script rather than rlm_sql/rlm_rest directly.
server dynamic-clients {
	authorize {
		hikrad_dynamic_client
		if (ok) {
			dynamic_clients
		}
		else {
			reject
		}
	}
}
